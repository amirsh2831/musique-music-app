generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  username        String?
  email           String?   @unique
  password        String?
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  favoriteArtists Artist[]  @relation("UserFavoriteArtists")
  likedTracks     Track[]   @relation("UserLikedTracks")
}

model Track {
  id        Int      @id @default(autoincrement())
  title     String
  artistId  Int
  albumId   Int?
  duration  Int
  audioUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  album     Album?   @relation("AlbumTracks", fields: [albumId], references: [id])
  artist    Artist   @relation("ArtistTracks", fields: [artistId], references: [id])
  likedBy   User[]   @relation("UserLikedTracks")
}

model Artist {
  name        String
  imageUrl    String?
  id          Int     @id @default(autoincrement())
  albums      Album[] @relation("ArtistAlbums")
  tracks      Track[] @relation("ArtistTracks")
  favoritedBy User[]  @relation("UserFavoriteArtists")
}

model Album {
  artistId  Int
  coverUrl  String?
  createdAt DateTime @default(now())
  title     String
  updatedAt DateTime @updatedAt
  id        Int      @id @default(autoincrement())
  coverLg   String?  @db.VarChar
  artist    Artist   @relation("ArtistAlbums", fields: [artistId], references: [id])
  tracks    Track[]  @relation("AlbumTracks")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
